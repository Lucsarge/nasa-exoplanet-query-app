<UserControl x:Class="nasa_exoplanet_query_app.SciVisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:nasa_exoplanet_query_app"
             xmlns:hx="http://helix-toolkit.org/wpf"
             xmlns:Media3D="clr-namespace:System.Windows.Media.Media3D;assembly=PresentationCore"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <!-- Radial Velocity Method Tools -->
        <DataTemplate x:Key="RadialVelocityToolsTemplate">
            <StackPanel Orientation="Vertical" Margin="10" DataContext="{Binding RadialVelocityMethod}">
                <TextBlock Text="Radial Velocity Parameters" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Min Mass:" Width="80"/>
                    <Slider Width="150" Minimum="0" Maximum="10" 
                            Value="{Binding MinMass, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding MinMass, StringFormat={}{0:F2} M⊕}" Width="60"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Eccentricity:" Width="80"/>
                    <Slider Width="150" Minimum="0" Maximum="1" 
                            Value="{Binding Eccentricity, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding Eccentricity, StringFormat={}{0:F2}}" Width="60"/>
                </StackPanel>
                <CheckBox Content="Show Velocity Curve" 
                          IsChecked="{Binding ShowVelocityCurve}" 
                          Margin="0,10,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- Transit Method Tools -->
        <DataTemplate x:Key="TransitToolsTemplate">
            <StackPanel Orientation="Vertical" Margin="10" DataContext="{Binding TransitMethod}">
                <TextBlock Text="Transit Parameters" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Planet Radius:" Width="80"/>
                    <Slider Width="150" Minimum="0.5" Maximum="5" 
                            Value="{Binding PlanetRadius, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding PlanetRadius, StringFormat={}{0:F2} R⊕}" Width="60"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Orbital Period:" Width="80"/>
                    <Slider Width="150" Minimum="1" Maximum="365" 
                            Value="{Binding OrbitalPeriod, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding OrbitalPeriod, StringFormat={}{0:F0} days}" Width="60"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Impact Parameter:" Width="80"/>
                    <Slider Width="150" Minimum="0" Maximum="1" 
                            Value="{Binding ImpactParameter, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding ImpactParameter, StringFormat={}{0:F2}}" Width="60"/>
                </StackPanel>
                <CheckBox Content="Show Transit Path" 
                          IsChecked="{Binding ShowTransitPath}" 
                          Margin="0,10,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- Default/Unknown Method Template -->
        <DataTemplate x:Key="DefaultToolsTemplate">
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Select a discovery method" FontStyle="Italic" 
                           Foreground="Gray" Margin="10"/>
            </StackPanel>
        </DataTemplate>

        <!-- Template Selector -->
        <local:DiscoveryMethodTemplateSelector x:Key="DiscoveryMethodTemplateSelector"
            RadialVelocityTemplate="{StaticResource RadialVelocityToolsTemplate}"
            TransitTemplate="{StaticResource TransitToolsTemplate}"
            DefaultTemplate="{StaticResource DefaultToolsTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Visualization Section (Helix Viewport) -->
        <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Visualization" FontWeight="Bold" 
                           Margin="10" FontSize="16"/>
                <hx:HelixViewport3D Grid.Row="1" 
                                    x:Name="MainViewport"
                                    ShowCoordinateSystem="True"
                                    CoordinateSystemLabelX="X"
                                    CoordinateSystemLabelY="Y"
                                    CoordinateSystemLabelZ="Z"
                                    Background="#1E1E1E">
                    <!-- Default Camera -->
                    <hx:HelixViewport3D.DefaultCamera>
                        <Media3D:PerspectiveCamera Position="10,10,10" LookDirection="0,0,0" UpDirection="0,0,1"/>
                    </hx:HelixViewport3D.DefaultCamera>
                    
                    <!-- Content will be populated by ViewModel -->
                    <ModelVisual3D x:Name="VisualizationContent"/>
                </hx:HelixViewport3D>
            </Grid>
        </Border>

        <!-- Tools Section (Dynamic based on discovery method) -->
        <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1,1,0,1" Margin="5,5,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Tools" FontWeight="Bold" 
                           Margin="10" FontSize="16"/>
                
                <!-- Dynamic Tools Content -->
                <ContentControl Grid.Row="1" 
                                DataContext="{Binding SciVisModel}"
                                Content="{Binding CurrentToolConfig}"
                                ContentTemplateSelector="{StaticResource DiscoveryMethodTemplateSelector}"/>
                
                <!-- Method Selection Dropdown -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="10">
                    <TextBlock Text="Discovery Method:" Margin="0,0,0,5"/>
                    <ComboBox DataContext="{Binding SciVisModel}"
                              ItemsSource="{Binding AvailableDiscoveryMethods}"
                              SelectedItem="{Binding SelectedDiscoveryMethod, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"/>
                    <Button Content="Apply Visualization" 
                            Command="{Binding ApplyVisualizationCommand}"
                            Margin="0,10,0,0"
                            Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary Section -->
        <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="0,1,1,1" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Summary" FontWeight="Bold" 
                           Margin="10" FontSize="16"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding SciVisModel.MethodSummary}" 
                               TextWrapping="Wrap" 
                               Padding="10"
                               FontSize="13"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
