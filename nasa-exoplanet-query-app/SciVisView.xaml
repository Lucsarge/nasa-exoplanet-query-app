<UserControl x:Class="nasa_exoplanet_query_app.SciVisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:nasa_exoplanet_query_app"
             xmlns:hx="http://helix-toolkit.org/wpf"
             xmlns:Media3D="clr-namespace:System.Windows.Media.Media3D;assembly=PresentationCore"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Visualization Section (Helix Viewport) -->
        <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Visualization" FontWeight="Bold"
                           Margin="10" FontSize="16"/>
                <ContentPresenter Grid.Row="1"
                                  Content="{Binding CurrentVisView}"/>
            </Grid>
        </Border>

        <!-- Tools Section (Dynamic based on discovery method) -->
        <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Margin="3,5,3,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Tools"
                           FontWeight="Bold"
                           Margin="10"
                           FontSize="16"/>
                
                <!-- Dynamic Tools Content -->
                <ContentPresenter Grid.Row="1"
                                  Content="{Binding CurrentToolView}"/>

                <!-- Method Selection Dropdown -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="10">
                    <TextBlock Text="Discovery Method:" Margin="0,0,0,5"/>
                    <ComboBox DataContext="{Binding SciVisModel}"
                              ItemsSource="{Binding AvailableDiscoveryMethods}"
                              SelectedItem="{Binding SelectedDiscoveryMethod, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"/>
                    <Button Content="Apply Visualization"
                            Command="{Binding ApplyVisualizationCommand}"
                            Margin="0,10,0,0"
                            Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary Section -->
        <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="1" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Summary" FontWeight="Bold" 
                           Margin="10" FontSize="16"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding SciVisModel.MethodSummary}"
                               TextWrapping="Wrap"
                               Padding="10"
                               FontSize="13"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
