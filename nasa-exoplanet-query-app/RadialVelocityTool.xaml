<UserControl x:Class="nasa_exoplanet_query_app.RadialVelocityTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:nasa_exoplanet_query_app"
             mc:Ignorable="d">
    <StackPanel Orientation="Vertical" Margin="10">
        <TextBlock Text="Radial Velocity Parameters" FontWeight="Bold" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Min Mass:" Width="80"/>
            <Slider Width="150" Minimum="0" Maximum="10"
            Value="{Binding MinMass, Mode=TwoWay}"/>
            <TextBlock Text="{Binding MinMass, StringFormat={}{0:F2} M⊕}" Width="60"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Eccentricity:"
                       Width="80"/>
            <Slider Width="150"
                    Minimum="0"
                    Maximum="1"
                    Value="{Binding Eccentricity, Mode=TwoWay}"/>
            <TextBlock Text="{Binding Eccentricity, StringFormat={}{0:F2}}" Width="60"/>
        </StackPanel>
        <CheckBox Content="Show Velocity Curve"
            IsChecked="{Binding ShowVelocityCurve}"
            Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
